# Defaults: the app runs on this device with no accounts.
# VITE_BACKEND=local

# Sync server. Leave VITE_API_URL empty when the site and the API share an origin
# (npm start serves dist/ and /api together). Set it for the Android app.
# VITE_BACKEND=server
# VITE_API_URL=https://livingo.example.com

# Supabase. The anon key is public; row policies in supabase/schema.sql protect the pair.
# VITE_BACKEND=supabase
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_VAPID_PUBLIC_KEY=

# Sync server process
# PORT=47322
# HOST=0.0.0.0
# DATA_DIR=server/data
# SERVE_STATIC=dist
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
